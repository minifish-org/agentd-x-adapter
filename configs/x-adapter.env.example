# Copy outside the repository, chmod 600, and populate without pasting secrets into chat.
AGENTD_URL=https://agentd.example.ts.net
AGENTD_TOKEN=REPLACE_ME
# Use a dedicated tenant: agentd outbox claims cannot filter by transport.
TENANT=x-agentd
AGENT_REF=x-bot
X_BOT_USERNAME=your_bot_username
# Run `agentd-x-adapter doctor your_owner_username` to resolve this stable numeric ID.
X_OWNER_ID=
X_API_KEY=REPLACE_ME
X_API_KEY_SECRET=REPLACE_ME
X_ACCESS_TOKEN=REPLACE_ME
X_ACCESS_TOKEN_SECRET=REPLACE_ME
STATE_PATH=/var/lib/agentd-x-adapter/adapter.db
POLL_SECS=60
# Both flags are required before public replies are enabled. Initial runs are preview-only.
X_PUBLISH=false
X_AI_REPLY_APPROVED=false
RUST_LOG=info
